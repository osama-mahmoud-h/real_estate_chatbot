    <!-- =========================================================================
         002-3: Seed Default Per-Flow & Per-Step LLM Assignments (db_chat)
         ========================================================================= -->
    <changeSet id="002-3-seed-llm-flow-step-configs" author="semsem">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="llm_flow_step_configs"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM llm_flow_step_configs WHERE flow_name = 'db_chat'</sqlCheck>
        </preConditions>

        <comment>Seed default db_chat step-level LLM model assignments</comment>

        <insert tableName="llm_flow_step_configs">
            <column name="flow_name" value="db_chat"/>
            <column name="step_name" value="entity_extractor"/>
            <column name="model_id" valueComputed="(SELECT model_id FROM llm_models WHERE model_key = 'openrouter_gemma26b')"/>
            <column name="max_tokens_override" valueNumeric="2048"/>
            <column name="temperature_override" valueNumeric="0.0"/>
            <column name="top_p_override" valueNumeric="0.95"/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="llm_flow_step_configs">
            <column name="flow_name" value="db_chat"/>
            <column name="step_name" value="sql_generator"/>
            <column name="model_id" valueComputed="(SELECT model_id FROM llm_models WHERE model_key = 'openrouter_gemma31b')"/>
            <column name="max_tokens_override" valueNumeric="4096"/>
            <column name="temperature_override" valueNumeric="0.0"/>
            <column name="top_p_override" valueNumeric="0.95"/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="llm_flow_step_configs">
            <column name="flow_name" value="db_chat"/>
            <column name="step_name" value="final_response"/>
            <column name="model_id" valueComputed="(SELECT model_id FROM llm_models WHERE model_key = 'openrouter_gemma31b')"/>
            <column name="max_tokens_override" valueNumeric="4096"/>
            <column name="temperature_override" valueNumeric="0.3"/>
            <column name="top_p_override" valueNumeric="0.95"/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="llm_flow_step_configs">
                <where>flow_name = 'db_chat'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
