<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- =========================================================================
         002-1: Seed Default Cloud & Local LLM Providers
         ========================================================================= -->
    <changeSet id="002-1-seed-llm-providers" author="semsem">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="llm_providers"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM llm_providers</sqlCheck>
        </preConditions>

        <comment>Seed default Cloud (OpenRouter, Gemini, Cohere, Anthropic, TogetherAI, HuggingFace) and Local (Ollama, vLLM) providers</comment>

        <insert tableName="llm_providers">
            <column name="provider_type" value="CLOUD"/>
            <column name="provider_key" value="openrouter"/>
            <column name="display_name" value="OpenRouter"/>
            <column name="base_url" value="https://openrouter.ai/api/v1"/>
            <column name="api_key" value=""/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="llm_providers">
            <column name="provider_type" value="CLOUD"/>
            <column name="provider_key" value="gemini"/>
            <column name="display_name" value="Google Gemini"/>
            <column name="base_url" value="https://generativelanguage.googleapis.com"/>
            <column name="api_key" value=""/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
