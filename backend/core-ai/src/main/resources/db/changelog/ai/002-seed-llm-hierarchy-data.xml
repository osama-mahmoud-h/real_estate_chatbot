            <column name="provider_key" value="huggingface"/>
            <column name="display_name" value="HuggingFace"/>
            <column name="base_url" value="https://api-inference.huggingface.co"/>
            <column name="api_key" value=""/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="llm_providers">
            <column name="provider_type" value="LOCAL"/>
            <column name="provider_key" value="ollama"/>
            <column name="display_name" value="Ollama Local"/>
            <column name="base_url" value="http://localhost:11434"/>
            <column name="timeout_seconds" valueNumeric="120"/>
            <column name="keep_alive" value="5m"/>
            <column name="extra_config" valueComputed="'{}'::jsonb"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="llm_providers">
