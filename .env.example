# =============================================================================
# Real Estate Chatbot - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=chatbot_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# AI PROVIDER CREDENTIALS (secrets)
# -----------------------------------------------------------------------------
# Only configure the providers you plan to use.

# Google Gemini (Cloud)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Cohere (Cloud)
COHERE_API_KEY=your_cohere_api_key_here

# Ollama (Local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# AI MODEL SELECTION
# -----------------------------------------------------------------------------
# Chat: choose provider (gemini | cohere | ollama) and model
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=llama3.2
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=4096

# Embedding: choose provider (gemini | cohere | ollama) and model
# Can be DIFFERENT from chat provider!
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# AVAILABLE MODELS (for reference)
# -----------------------------------------------------------------------------
# Gemini Chat: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# Gemini Embedding: text-embedding-004
#
# Cohere Chat: command-r-plus, command-r, command-light
# Cohere Embedding: embed-english-v3.0, embed-multilingual-v3.0
#
# Ollama Chat: llama3.2, mistral, codellama, qwen2.5
# Ollama Embedding: nomic-embed-text, mxbai-embed-large, all-minilm

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# DOCKER DEPLOYMENT
# -----------------------------------------------------------------------------
# When using docker-compose, set these:
# DATABASE_HOST=postgres (service name)
# OLLAMA_BASE_URL=http://ollama:11434 (service name)
# SPRING_PROFILES_ACTIVE=docker